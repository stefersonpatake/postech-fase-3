# Copie este arquivo para ".env" na raiz e preencha os valores reais.
# O docker-compose.yml lê essas variáveis automaticamente.

# --- AWS (evaluation-service envia para SQS; analytics-service consome do SQS
# e grava no DynamoDB) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Só necessário se estiver usando AWS Academy
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# URL da fila SQS real na AWS (não há emulador local de SQS neste compose)
AWS_SQS_URL=

# Nome da tabela no DynamoDB (real ou local, ver AWS_DYNAMODB_ENDPOINT_URL no
# analytics-service dentro do docker-compose.yml, que já aponta para o
# DynamoDB Local por padrão)
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# --- evaluation-service ---
# Passo manual: com auth-service já rodando, crie a chave de serviço com
#   curl -X POST http://localhost:8001/admin/keys \
#     -H "Content-Type: application/json" \
#     -H "Authorization: Bearer admin-secreto-123" \
#     -d '{"name": "evaluation-service-key"}'
# e cole a chave retornada (campo "key") aqui antes de subir/reiniciar o
# evaluation-service.
SERVICE_API_KEY=
